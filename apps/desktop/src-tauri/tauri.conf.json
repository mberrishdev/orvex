{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orvex",
  "version": "0.1.0-beta.4",
  "identifier": "com.orvex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Orvex \u00b7 Workspaces",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F5F5F7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyRDg4RkI1RUZGNzRCMjIKUldRaVMvZnZ0WS9ZVWlaTU1ZcFRuWVBCRk9vVWpmNXRMNWxDamNUVW80MjJGYU1QeFQrQUF4RzUK",
      "endpoints": [
        "https://github.com/mberrishdev/orvex/releases/download/updater-beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
