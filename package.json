{
  "name": "orvex",
  "private": true,
  "version": "0.1.0-beta.3",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --filter @orvex/desktop tauri dev",
    "build": "pnpm --filter @orvex/desktop build",
    "check:rust": "cargo check --workspace",
    "orvex": "cargo run --package orvex-desktop --bin orvex",
    "tauri": "pnpm --filter @orvex/desktop tauri",
    "install:cli": "node scripts/install-cli.mjs",
    "check:mcp": "node scripts/check-mcp.mjs"
  }
}
